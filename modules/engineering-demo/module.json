{
  "id": "engineering-demo",
  "version": "0.1.0",
  "description": "Engineering Workbench reference",
  "dependencies": [
    "canvas@0.1.0",
    "viewport@0.1.0",
    "documents@0.1.0",
    "evaluation@0.1.0",
    "science@0.1.0",
    "reference-runtime@0.1.0",
    "tasks@0.1.0"
  ],
  "profiles": [
    "desktop-egui"
  ],
  "targets": [
    "native"
  ],
  "license": "MIT OR Apache-2.0",
  "provenance": "Original starter code, see docs/SOURCES.md",
  "documentation": "docs/modules/engineering-demo.md",
  "files": [
    "crates/starter-demo-domain/Cargo.toml",
    "crates/starter-demo-domain/src/lib.rs",
    "crates/starter-demo/Cargo.toml",
    "crates/starter-demo/src/lib.rs",
    "docs/modules/engineering-demo.md"
  ],
  "features": [
    "starter-demo/ui-inspection"
  ],
  "checks": [
    "cargo test --workspace"
  ],
  "conflicts": [
    "document-demo",
    "data-demo"
  ],
  "cargo_dependencies": {
    "crates/starter-demo-domain/Cargo.toml": {
      "dependencies": {
        "starter-core": {
          "path": "../starter-core"
        },
        "serde": {
          "version": "1",
          "features": [
            "derive"
          ]
        },
        "schemars": "1",
        "starter-documents": {
          "path": "../starter-documents"
        },
        "starter-evaluation": {
          "path": "../starter-evaluation"
        },
        "starter-science": {
          "path": "../starter-science"
        }
      }
    },
    "crates/starter-demo/Cargo.toml": {
      "dependencies": {
        "eframe": {
          "version": "0.37",
          "default-features": false,
          "features": [
            "default_fonts",
            "wgpu"
          ]
        },
        "starter-reference": {
          "path": "../starter-reference"
        },
        "starter-desktop": {
          "path": "../starter-desktop"
        },
        "starter-demo-domain": {
          "path": "../starter-demo-domain"
        },
        "serde_json": "1",
        "starter-canvas": {
          "path": "../starter-canvas"
        },
        "starter-viewport-core": {
          "path": "../starter-viewport-core"
        },
        "starter-viewport-egui": {
          "path": "../starter-viewport-egui"
        },
        "starter-tasks": {
          "path": "../starter-tasks"
        }
      }
    }
  },
  "manifests": {
    "Cargo.toml": {
      "workspace": {
        "members": [
          "crates/starter-demo",
          "crates/starter-demo-domain"
        ],
        "resolver": "3"
      }
    }
  },
  "provider": "desktop-view",
  "kind": "desktop-provider"
}
