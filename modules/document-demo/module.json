{
  "id": "document-demo",
  "version": "0.1.0",
  "description": "Document Workbench reference",
  "dependencies": [
    "documents@0.1.0",
    "reference-runtime@0.1.0"
  ],
  "profiles": [
    "desktop-egui"
  ],
  "targets": [
    "native"
  ],
  "license": "MIT OR Apache-2.0",
  "provenance": "Original starter code, see docs/SOURCES.md",
  "documentation": "docs/modules/document-demo.md",
  "files": [
    "crates/app/src/lib.rs",
    "crates/desktop/src/main.rs",
    "crates/starter-demo-domain/Cargo.toml",
    "crates/starter-demo-domain/src/lib.rs",
    "crates/starter-demo/Cargo.toml",
    "crates/starter-demo/src/lib.rs",
    "docs/modules/document-demo.md"
  ],
  "features": [
    "starter-demo/ui-inspection",
    "desktop/ui-inspection"
  ],
  "checks": [
    "cargo test --workspace"
  ],
  "conflicts": [
    "data-demo",
    "engineering-demo"
  ],
  "cargo_dependencies": {
    "crates/starter-demo-domain/Cargo.toml": {
      "dependencies": {
        "starter-core": {
          "path": "../starter-core"
        },
        "serde": {
          "version": "1",
          "features": [
            "derive"
          ]
        },
        "schemars": "1",
        "starter-documents": {
          "path": "../starter-documents"
        }
      }
    },
    "crates/starter-demo/Cargo.toml": {
      "dependencies": {
        "eframe": {
          "version": "0.37",
          "default-features": false,
          "features": [
            "default_fonts",
            "wgpu"
          ]
        },
        "starter-reference": {
          "path": "../starter-reference"
        },
        "starter-desktop": {
          "path": "../starter-desktop"
        },
        "starter-demo-domain": {
          "path": "../starter-demo-domain"
        },
        "serde_json": "1",
        "starter-documents": {
          "path": "../starter-documents"
        }
      },
      "dev-dependencies": {
        "tempfile": "3"
      }
    }
  },
  "manifests": {
    "Cargo.toml": {
      "workspace": {
        "members": [
          "crates/starter-demo",
          "crates/starter-demo-domain"
        ],
        "resolver": "3"
      }
    },
    "crates/app/Cargo.toml": {
      "dependencies": {
        "starter-demo": {
          "path": "../starter-demo"
        }
      },
      "features": {
        "ui-inspection": [
          "starter-demo/ui-inspection"
        ]
      }
    },
    "crates/desktop/Cargo.toml": {
      "features": {
        "ui-inspection": [
          "ui_app/ui-inspection"
        ]
      }
    }
  },
  "replace": {
    "desktop-egui": [
      "crates/app/src/lib.rs",
      "crates/desktop/src/main.rs"
    ]
  }
}
