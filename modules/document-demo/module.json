{
  "id": "document-demo",
  "version": "0.1.0",
  "description": "Document Workbench reference",
  "dependencies": [
    "documents@0.1.0",
    "reference-runtime@0.1.0",
    "tasks@0.1.0"
  ],
  "profiles": [
    "desktop-egui"
  ],
  "targets": [
    "native"
  ],
  "license": "MIT OR Apache-2.0",
  "provenance": "Original starter code, see docs/SOURCES.md",
  "documentation": "docs/modules/document-demo.md",
  "files": [
    "crates/starter-demo/Cargo.toml",
    "crates/starter-demo/src/lib.rs",
    "docs/modules/document-demo.md"
  ],
  "features": [
    "starter-demo/ui-inspection"
  ],
  "checks": [
    "cargo test --workspace"
  ],
  "conflicts": [
    "data-demo",
    "engineering-demo"
  ],
  "cargo_dependencies": {
    "crates/starter-demo/Cargo.toml": {
      "dependencies": {
        "eframe": {
          "version": "0.37",
          "default-features": false,
          "features": [
            "default_fonts",
            "wgpu"
          ]
        },
        "starter-reference": {
          "path": "../starter-reference"
        },
        "starter-desktop": {
          "path": "../starter-desktop"
        },
        "starter-notes": {
          "path": "../starter-notes"
        },
        "serde_json": "1",
        "starter-documents": {
          "path": "../starter-documents"
        },
        "starter-tasks": {
          "path": "../starter-tasks"
        }
      },
      "dev-dependencies": {
        "tempfile": "3"
      }
    }
  },
  "manifests": {
    "Cargo.toml": {
      "workspace": {
        "members": [
          "crates/starter-demo"
        ],
        "resolver": "3"
      }
    }
  },
  "provider": "desktop-view",
  "kind": "desktop-provider"
}
