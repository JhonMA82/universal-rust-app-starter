{
  "id": "application-mcp",
  "version": "0.1.0",
  "description": "Official rmcp adapter for application operations",
  "dependencies": [
    "application-core@0.1.0"
  ],
  "profiles": [],
  "targets": [
    "native"
  ],
  "license": "MIT OR Apache-2.0",
  "provenance": "Original starter code, see docs/SOURCES.md",
  "documentation": "docs/modules/application-mcp.md",
  "files": [
    ".agents/skills/application-operations/SKILL.md",
    "crates/starter-mcp/Cargo.toml",
    "crates/starter-mcp/src/lib.rs",
    "docs/modules/application-mcp.md"
  ],
  "features": [],
  "checks": [
    "cargo test --workspace"
  ],
  "conflicts": [],
  "cargo_dependencies": {
    "crates/starter-mcp/Cargo.toml": {
      "dependencies": {
        "rmcp": {
          "version": "3.11",
          "features": [
            "server",
            "transport-io"
          ]
        },
        "schemars": "1",
        "serde": {
          "version": "1",
          "features": [
            "derive"
          ]
        },
        "serde_json": "1",
        "starter-core": {
          "path": "../starter-core"
        },
        "tokio": {
          "version": "1",
          "features": [
            "rt-multi-thread",
            "io-std"
          ]
        }
      }
    }
  },
  "manifests": {
    "Cargo.toml": {
      "workspace": {
        "members": [
          "crates/starter-mcp"
        ],
        "resolver": "3"
      }
    }
  }
}
