{
  "id": "reference-runtime",
  "version": "0.1.0",
  "description": "Shared egui host and optional native automation adapters",
  "dependencies": [
    "application-core@0.1.0",
    "desktop-shell@0.1.0"
  ],
  "profiles": [
    "desktop-egui",
    "desktop-egui-web"
  ],
  "targets": [
    "native",
    "wasm"
  ],
  "license": "MIT OR Apache-2.0",
  "provenance": "Original starter code, see docs/SOURCES.md",
  "documentation": "docs/modules/reference-runtime.md",
  "files": [
    "crates/starter-reference/Cargo.toml",
    "crates/starter-reference/examples/inspection_smoke.rs",
    "crates/starter-reference/src/lib.rs",
    "crates/starter-reference/src/palette.rs",
    "docs/modules/reference-runtime.md"
  ],
  "features": [
    "starter-reference/ui-inspection"
  ],
  "checks": [
    "cargo test --workspace"
  ],
  "conflicts": [],
  "cargo_dependencies": {
    "crates/starter-reference/Cargo.toml": {
      "dependencies": {
        "eframe": {
          "version": "0.37",
          "default-features": false,
          "features": [
            "default_fonts",
            "wgpu",
            "accesskit",
            "persistence"
          ]
        },
        "starter-core": {
          "path": "../starter-core"
        },
        "starter-desktop": {
          "path": "../starter-desktop"
        },
        "serde_json": "1"
      },
      "target": {
        "cfg(not(target_arch = \"wasm32\"))": {
          "dependencies": {
            "egui_inspection": {
              "version": "0.37",
              "features": [
                "plugin"
              ],
              "optional": true
            }
          }
        },
        "cfg(target_arch = \"wasm32\")": {
          "dependencies": {
            "web-sys": {
              "version": "0.3",
              "features": [
                "Document",
                "Element",
                "Window"
              ],
              "optional": true
            }
          }
        }
      },
      "dev-dependencies": {
        "egui_kittest": "0.37"
      }
    }
  },
  "manifests": {
    "Cargo.toml": {
      "workspace": {
        "members": [
          "crates/starter-reference"
        ],
        "resolver": "3"
      }
    }
  },
  "kind": "composition-host"
}
